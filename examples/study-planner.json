{
  "surface": {
    "surfaceId": "study-planner",
    "catalogId": "handson-basic-catalog",
    "theme": { "primaryColor": "#10b981" }
  },
  "components": [
    {
      "id": "root",
      "component": "Column",
      "children": ["header", "subjects_card", "schedule_card", "actions"],
      "gap": 16,
      "align": "stretch"
    },

    { "id": "header", "component": "Row", "children": ["header_icon", "header_texts"], "align": "center", "gap": 12 },
    { "id": "header_icon", "component": "Icon", "name": "📚", "size": 36 },
    { "id": "header_texts", "component": "Column", "children": ["header_title", "header_sub"], "gap": 4 },
    { "id": "header_title", "component": "Text", "text": { "path": "/title" }, "variant": "headline" },
    { "id": "header_sub", "component": "Text", "text": { "path": "/subtitle" }, "variant": "body", "color": "secondary" },

    { "id": "subjects_card", "component": "Card", "child": "subjects_inner" },
    { "id": "subjects_inner", "component": "Column", "children": ["subjects_title", "subjects_list"], "gap": 12 },
    { "id": "subjects_title", "component": "Text", "text": "📖 오늘의 학습 과목", "variant": "title" },
    {
      "id": "subjects_list",
      "component": "Column",
      "children": { "path": "/subjects", "componentId": "subject_template" },
      "gap": 8
    },
    {
      "id": "subject_template",
      "component": "Row",
      "children": ["subject_check", "subject_name", "subject_time"],
      "align": "center",
      "gap": 12
    },
    { "id": "subject_check", "component": "CheckBox", "value": { "path": "done" } },
    { "id": "subject_name", "component": "Text", "text": { "path": "name" }, "variant": "body" },
    { "id": "subject_time", "component": "Text", "text": { "path": "duration" }, "variant": "caption" },

    { "id": "schedule_card", "component": "Card", "child": "schedule_inner" },
    { "id": "schedule_inner", "component": "Column", "children": ["schedule_title", "schedule_table"], "gap": 12 },
    { "id": "schedule_title", "component": "Text", "text": "🕐 오늘의 시간표", "variant": "title" },
    {
      "id": "schedule_table",
      "component": "DataTable",
      "columns": { "path": "/schedule/columns" },
      "rows": { "path": "/schedule/rows" }
    },

    { "id": "actions", "component": "Row", "children": ["btn_done", "btn_reshuffle"], "gap": 12 },
    {
      "id": "btn_done",
      "component": "Button",
      "label": "✅ 완료한 과목 처리",
      "variant": "primary",
      "action": { "name": "complete_task" }
    },
    {
      "id": "btn_reshuffle",
      "component": "Button",
      "label": "🔀 시간표 재배치",
      "variant": "secondary",
      "action": { "name": "regenerate_plan" }
    }
  ],
  "dataModel": {
    "title": "오늘의 학습 플래너",
    "subtitle": "AI가 최적화한 학습 순서입니다",
    "subjects": [
      { "name": "알고리즘 (DP 문제 풀기)", "done": false, "duration": "90분" },
      { "name": "A2UI 핸즈온 자료 정리", "done": false, "duration": "60분" },
      { "name": "운영체제 중간고사 복습", "done": false, "duration": "45분" },
      { "name": "영어 회화 연습", "done": false, "duration": "30분" }
    ],
    "schedule": {
      "columns": ["시간", "학습 내용", "소요 시간"],
      "rows": [
        ["09:00 - 10:30", "알고리즘 (DP 문제 풀기)", "90분"],
        ["10:30 - 11:30", "A2UI 핸즈온 자료 정리", "60분"],
        ["13:00 - 13:45", "운영체제 중간고사 복습", "45분"],
        ["14:00 - 14:30", "영어 회화 연습", "30분"]
      ]
    }
  }
}
